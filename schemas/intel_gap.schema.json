{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IntelGap",
  "description": "Single intelligence gap entry in the tasking layer.",
  "type": "object",
  "required": [
    "id", "theater", "priority", "question", "why_it_matters",
    "evidence_that_would_resolve", "search_queries_to_try",
    "current_collection_status", "created_date", "last_researched", "status"
  ],
  "properties": {
    "id":                        { "type": "string", "pattern": "^GAP-(\\d{3}|\\d{4}-\\d{2}-\\d{2}-\\d{3})$" },
    "theater":                   { "type": "string", "minLength": 1 },
    "priority":                  { "enum": ["critical", "important", "monitoring"] },
    "category":                  { "enum": ["world", "methodology"], "description": "methodology = pipeline-self-monitoring gap; excluded from the reader-facing Outlook projection by scripts/build.js. Omitted/world = reader-visible." },
    "question":                  { "type": "string", "minLength": 10 },
    "why_it_matters":            { "type": "string", "minLength": 10 },
    "evidence_that_would_resolve": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "search_queries_to_try": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "current_collection_status": { "type": "string", "minLength": 1 },
    "days_open":                 { "type": "integer", "minimum": 0 },
    "created_date":              { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "last_researched":           { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "linked_forecasts":          { "type": "array", "items": { "type": "string" } },
    "linked_indicators":         { "type": "array", "items": { "type": "string" } },
    "held_for_verification":     { "type": "boolean" },
    "verification_cycles":       { "type": "integer", "minimum": 0 },
    "resolution":                { "type": ["string", "null"] },
    "status":                    { "enum": ["open", "resolved", "stale", "voided"] }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forecast",
  "description": "Single forecast entry in the intelligence tasking layer.",
  "type": "object",
  "required": [
    "id", "created_date", "theater", "question", "resolution_criteria",
    "deadline", "probability", "probability_history", "status",
    "risk_axis_impact", "surprise_if_wrong"
  ],
  "properties": {
    "id":                  { "type": "string", "pattern": "^FC-\\d{4}-\\d{2}-\\d{2}-\\d{3}$" },
    "created_date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "theater":             { "type": "string", "minLength": 1 },
    "question":            { "type": "string", "minLength": 10 },
    "resolution_criteria": { "type": "string", "minLength": 10 },
    "deadline":            { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "probability":         { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "probability_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "probability", "reason"],
        "properties": {
          "date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "probability": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "reason":      { "type": "string", "minLength": 1 }
        }
      }
    },
    "status":              { "enum": ["open", "resolved-yes", "resolved-no", "expired", "voided"] },
    "outcome":             { "type": ["string", "null"] },
    "resolution_date":     { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "resolution_source":   { "type": ["string", "null"] },
    "risk_axis_impact": {
      "type": "object",
      "required": ["kinetic", "greatpower", "wmd", "alliance"],
      "properties": {
        "kinetic":    { "type": "integer" },
        "greatpower": { "type": "integer" },
        "wmd":        { "type": "integer" },
        "alliance":   { "type": "integer" }
      }
    },
    "surprise_if_wrong":   { "type": "string", "minLength": 1 },
    "linked_forecasts":    { "type": "array", "items": { "type": "string" } },
    "tags":                { "type": "array", "items": { "type": "string" } }
  }
}

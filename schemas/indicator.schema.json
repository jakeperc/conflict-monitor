{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Indicator",
  "description": "Single leading indicator entry in the intelligence tasking layer.",
  "type": "object",
  "required": [
    "id", "theater", "type", "indicator", "baseline_date",
    "watch_window_end", "current_signal_strength", "signal_history",
    "threshold_for_activation", "activated", "consequence_if_activated", "status"
  ],
  "properties": {
    "id":                       { "type": "string", "pattern": "^IND-[a-z0-9-]+-\\d{3}$" },
    "theater":                  { "type": "string", "minLength": 1 },
    "type":                     { "enum": ["escalation", "de-escalation", "epistemic-discipline", "methodology-tripwire"] },
    "indicator":                { "type": "string", "minLength": 5 },
    "baseline_date":            { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "watch_window_end":         { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "current_signal_strength":  { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "signal_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "strength", "evidence"],
        "properties": {
          "date":     { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "strength": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "threshold_for_activation": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "activated":                { "type": "boolean" },
    "activation_date":          { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "consequence_if_activated": { "type": "string", "minLength": 1 },
    "linked_forecast":          { "type": ["string", "null"] },
    "status":                   { "enum": ["watching", "activated", "expired", "retired"] }
  }
}

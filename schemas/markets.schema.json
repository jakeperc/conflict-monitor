{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Markets History",
  "type": "object",
  "required": ["ww3_history", "hormuz_history", "brent_history", "gas_nat_history", "gas_history"],
  "properties": {
    "ww3_history":    { "type": "array", "items": { "type": "number" } },
    "hormuz_history": { "type": "array", "items": { "type": "number" } },
    "brent_history":  { "type": "array", "items": { "type": "number" } },
    "gas_nat_history":{ "type": "array", "items": { "type": "number" } },
    "ww3_history_last_date":      { "type": "string" },
    "brent_history_last_date":    { "type": "string" },
    "gas_nat_history_last_date":  { "type": "string" },
    "brent_daily": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["d", "v"],
        "properties": {
          "d": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "v": { "type": "number" }
        }
      }
    },
    "gas_daily": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["d"],
        "properties": {
          "d":   { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "nat": { "type": "number" },
          "ca":  { "type": "number" },
          "diesel": { "type": "number" }
        }
      }
    },
    "diesel_eia_weekly": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["d", "v"],
        "properties": {
          "d": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "v": { "type": "number" }
        }
      }
    },
    "diesel_eia_weekly_source": {
      "type": "object",
      "required": ["source", "series_id", "url", "retrieved", "through"],
      "properties": {
        "source":         { "type": "string" },
        "series_id":      { "type": "string" },
        "unit":           { "type": "string" },
        "url":            { "type": "string" },
        "retrieved_via":  { "type": "string" },
        "retrieved":      { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "through":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "prewar_baseline": {
          "type": ["object", "null"],
          "properties": {
            "d":    { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "v":    { "type": "number" },
            "note": { "type": "string" }
          }
        }
      }
    },
    "gas_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["week", "nat", "ca"],
        "properties": {
          "week": { "type": "string" },
          "nat":  { "type": "number" },
          "ca":   { "type": "number" }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Economic Commentary",
  "type": "object",
  "required": ["cards"],
  "properties": {
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["key", "title", "color", "body", "updated_at"],
        "properties": {
          "key":        { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title":      { "type": "string", "minLength": 1, "maxLength": 80 },
          "color":      { "enum": ["blue", "amber", "violet", "danger", "green"] },
          "body":       { "type": "string", "minLength": 1, "maxLength": 1100 },
          "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}

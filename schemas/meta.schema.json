{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dashboard Metadata",
  "type": "object",
  "required": ["dashboard_title", "war_start", "now", "ww3_pct", "base_last_update", "version"],
  "properties": {
    "dashboard_title":  { "type": "string", "minLength": 1 },
    "war_start":        { "type": "string" },
    "now":              { "type": "string" },
    "ww3_pct":          { "type": "integer", "minimum": 0, "maximum": 100 },
    "ww3_now_label":    { "type": "string", "maxLength": 80 },
    "base_last_update": { "type": "string", "minLength": 1 },
    "last_built":       { "type": ["string", "null"] },
    "version":          { "type": "string" },
    "notes":            { "type": "string" },
    "hormuz_status": {
      "type": "object",
      "required": ["label", "as_of"],
      "properties": {
        "label": { "enum": ["OPEN", "ESCORTED", "CONTESTED", "DISRUPTED", "CLOSED"] },
        "note":  { "type": "string", "maxLength": 200 },
        "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
